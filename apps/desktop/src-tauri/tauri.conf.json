{
    "$schema":  "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName":  "AI Interpretation Assistant",
    "version":  "0.4.9",
    "identifier":  "com.online.ai-interpretation",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://127.0.0.1:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "AI 同声传译助手",
                                    "width":  1280,
                                    "height":  820,
                                    "minWidth":  1080,
                                    "minHeight":  720,
                                    "resizable":  true
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; script-src \u0027self\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; connect-src \u0027self\u0027 ws://127.0.0.1:8765 http://127.0.0.1:8765; img-src \u0027self\u0027 data:"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "externalBin":  [
                                       "binaries/ai-interpretation-runtime"
                                   ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "createUpdaterArtifacts":  true
               },
    "plugins":  {
                    "updater":  {
                                    "endpoints":  [
                                                      "https://github.com/wynxing/online/releases/latest/download/latest.json"
                                                  ],
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyMTY2N0E1NjY2QjVGN0QKUldSOVgydG1wV2NXa24yOXdDbWM1ejBsQWRaY3VlaFNXSEN3RUNMelhJdUtSS3ZEdTVpaE1kcW0K",
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                }
                }
}