{
  "name": "ai-simultaneous-interpretation-assistant",
  "private": true,
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "desktop": "npm run dev -w apps/desktop",
    "desktop:build": "npm run build -w apps/desktop",
    "tauri": "npm run tauri -w apps/desktop --",
    "tauri:dev": "npm run tauri:dev -w apps/desktop",
    "release:local": "node scripts/build-release-local.mjs",
    "lint": "npm run lint -w apps/desktop",
    "lint:fix": "npm run lint:fix -w apps/desktop",
    "test": "npm run test -w apps/desktop",
    "test:coverage": "npm run test:coverage -w apps/desktop",
    "test:version": "node --test scripts/check-version-consistency.test.mjs",
    "version:check": "node scripts/check-version-consistency.mjs",
    "version:bump": "powershell -ExecutionPolicy Bypass -File scripts/bump-version.ps1",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7"
  },
  "lint-staged": {
    "apps/desktop/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
